{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://immersive.hatinh.example/schemas/panorama-manifest.schema.json",
  "title": "Hà Tĩnh immersive panorama manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "type", "preview", "tileUrlTemplate", "levels"],
  "properties": {
    "version": { "const": 1 },
    "type": { "const": "equirectangular-tiles" },
    "preview": { "type": "string", "minLength": 1 },
    "tileUrlTemplate": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        { "pattern": "\\{level\\}" },
        { "pattern": "\\{col\\}" },
        { "pattern": "\\{row\\}" }
      ]
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["width", "cols", "rows"],
        "properties": {
          "width": { "type": "integer", "minimum": 1 },
          "cols": { "type": "integer", "minimum": 1 },
          "rows": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}

{
  "name": "@hatinh/api",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx src/core/database/migrate.ts",
    "db:seed": "tsx src/core/database/seed.ts",
    "openapi:export": "tsx src/openapi-export.ts",
    "start": "node dist/main.js",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run test",
    "test:e2e": "vitest run test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1105.0",
    "@aws-sdk/s3-request-presigner": "3.1105.0",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "10.1.3",
    "@hatinh/immersive-contracts": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "argon2": "0.43.1",
    "drizzle-orm": "0.45.2",
    "fastify": "5.11.2",
    "nestjs-pino": "4.6.1",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.34.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.28",
    "@types/node": "26.2.0",
    "drizzle-kit": "0.31.10",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}

{
  "name": "@hatinh/immersive-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11.3.0 <12"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "architecture:check": "depcruise --config .dependency-cruiser.cjs apps packages tooling && node tooling/scripts/architecture-check.mjs --workspace",
    "deadcode": "knip",
    "repo:smoke": "node tooling/scripts/repo-smoke.mjs",
    "api:generate": "pnpm --filter @hatinh/api openapi:export && pnpm --filter @hatinh/api-client generate && prettier --write packages/api-client/openapi.json",
    "panorama:build": "pnpm --filter @hatinh/panorama-tooling panorama:build",
    "panorama:test": "pnpm --filter @hatinh/panorama-tooling test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "10.0.1",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "dependency-cruiser": "18.1.1",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.9.0",
    "husky": "9.1.7",
    "knip": "6.32.0",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "turbo": "2.10.8",
    "typescript": "6.0.3"
  }
}
